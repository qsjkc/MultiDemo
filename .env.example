# ====== 火山引擎 RTC 配置 ======
# 访问 https://console.volcengine.com/iam/keymanage 获取
VOLCANO_AK=your_access_key_id
VOLCANO_SK=your_secret_access_key

# 访问 https://console.volcengine.com/rtc/listRTC 获取
RTC_APP_ID=your_rtc_app_id
RTC_APP_KEY=your_rtc_app_key

# ASR/TTS AppId（可选，留空使用默认）
ASR_APP_ID=
TTS_APP_ID=

# ====== Agent 服务器配置 ======
# Agent 服务器公网地址，必须以 http:// 或 https:// 开头
AGENT_SERVER_URL=https://your-server.com/chat
AGENT_API_KEY=agent-secret-key

# 智能体在 RTC 房间中的用户 ID
BOT_USER_ID=ai_bot_001

# ====== Agent 服务器 LLM 配置 ======
# LLM API Key（模型调用密钥）
LLM_API_KEY=your_llm_api_key
# LLM API 地址（默认火山方舟）
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 模型名称
LLM_MODEL=doubao-pro-32k

# ====== 服务端口 ======
CLIENT_PORT=5000
CLIENT_HOST=0.0.0.0
AGENT_PORT=8080
AGENT_HOST=0.0.0.0